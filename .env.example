# --- SQL Server Database Configuration ---
DB_DRIVER={ODBC Driver 18 for SQL Server}
DB_SERVER=localhost
DB_NAME=HandymanDB
# OPTIONAL: If using SQL Server Authentication instead of Windows Authentication:
DB_USER=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes

DB_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=HandymanDB;Trusted_Connection=yes;TrustServerCertificate=yes;
MASTER_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=master;Trusted_Connection=yes;TrustServerCertificate=yes;

# --- LM Studio / OpenAI Local LLM Configuration ---
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# --- The active version of the harness algorithm
ALGORITHM_VERSION=v1

# LM Studio Config
LM_STUDIO_URL = os.getenv("LM_STUDIO_URL", "http://localhost:1234/v1")
LM_STUDIO_API_KEY = os.getenv("LM_STUDIO_API_KEY", "lm-studio")

