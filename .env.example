# =========================================================================
# Dynamic Prompt Wizard - Environment Configuration Template
# Copy this file to `.env` in the same directory and customize for your local setup.
# =========================================================================

# --- SQL Server Database Configuration ---
DB_DRIVER={ODBC Driver 18 for SQL Server}
DB_SERVER=localhost
DB_NAME=HandymanDB
# OPTIONAL: If using SQL Server Authentication instead of Windows Authentication:
DB_USER=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes

DB_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=HandymanDB;Trusted_Connection=yes;TrustServerCertificate=yes;
MASTER_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=master;Trusted_Connection=yes;TrustServerCertificate=yes;

# --- LM Studio / OpenAI Local LLM Configuration ---
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# --- The active version of the harness algorithm
ALGORITHM_VERSION=v2

# LM Studio Config
LM_STUDIO_URL = os.getenv("LM_STUDIO_URL", "http://localhost:1234/v1")
LM_STUDIO_API_KEY = os.getenv("LM_STUDIO_API_KEY", "lm-studio")

# Langsmith 
LANGSMITH_API_KEY=your-api-key-here
LANGSMITH_PROJECT=HandymanTenderMaker
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Langsmith - Online eval: sample rates and annotation queue IDs ---
DATA_VALIDATOR_SAMPLE_RATE=1.0
DATA_VALIDATOR_GOOD_QUEUE_ID=
DATA_VALIDATOR_CORRECTION_QUEUE_ID=

CATEGORIZER_SAMPLE_RATE=1.0
CATEGORIZER_GOOD_QUEUE_ID=
CATEGORIZER_CORRECTION_QUEUE_ID=

CONTRACTOR_CATEGORIZER_SAMPLE_RATE=1.0
CONTRACTOR_CATEGORIZER_GOOD_QUEUE_ID=
CONTRACTOR_CATEGORIZER_CORRECTION_QUEUE_ID=

MULTI_TASK_ARCHITECT_SAMPLE_RATE=1.0
MULTI_TASK_ARCHITECT_GOOD_QUEUE_ID=
MULTI_TASK_ARCHITECT_CORRECTION_QUEUE_ID=

INFORMATION_GATHERER_SAMPLE_RATE=1.0
INFORMATION_GATHERER_GOOD_QUEUE_ID=
INFORMATION_GATHERER_CORRECTION_QUEUE_ID=

TENDER_CREATOR_SAMPLE_RATE=1.0
TENDER_CREATOR_GOOD_QUEUE_ID=
TENDER_CREATOR_CORRECTION_QUEUE_ID=

# --- Groq
GROQ_API_KEY=